{
  "name": "fly-dragon-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Fly Dragon AI - visa/flights/hotels chat assistant on Cloudflare Workers + Hono + D1 + R2",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8788",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:apply:local": "wrangler d1 execute fly-dragon-db --local --file ./src/db/schema.sql",
    "db:apply:remote": "wrangler d1 execute fly-dragon-db --remote --file ./src/db/schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply fly-dragon-db --local",
    "bucket:create": "wrangler r2 bucket create fly-dragon-uploads",
    "secrets:ls": "wrangler secret list",
    "test": "node --test test/integration.test.mjs",
    "test:browser": "node test/browser-real.cjs",
    "test:all": "npm test && npm run test:browser",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "miniflare": "^3.20250101.0",
    "wrangler": "^4.19.0"
  },
  "engines": {
    "node": ">=22.4"
  }
}
