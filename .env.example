# ============================================================================
# FlyDragon AI - local development environment
#   cp .env.example .dev.vars        (wrangler reads .dev.vars for `wrangler dev`)
# Production values go in as secrets:  npx wrangler secret put <NAME>
# Only JWT_SECRET, MCP_ENCRYPTION_KEY and OPENAI_API_KEY are real secrets.
# The rest are plain [vars] in wrangler.toml.
# ============================================================================

# --- required ------------------------------------------------------------
# Signs the session JWT. 32+ random bytes, never reuse across environments.
JWT_SECRET=change-me-to-a-long-random-string-32-bytes-min
# Encrypts MCP API keys at rest (AES-GCM). Rotating it invalidates saved keys.
MCP_ENCRYPTION_KEY=change-me-to-another-long-random-string

# --- the model -----------------------------------------------------------
# Leave OPENAI_API_KEY EMPTY to use the Workers AI binding (no key needed).
# Set it to use OpenAI instead; OPENAI_BASE is only for gateways/proxies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE=https://api.openai.com/v1
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Google sign-in (Auth Task) ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth -> Authorized redirect URI must be exactly:
#   https://<your-host>/api/auth/google/callback
#   http://127.0.0.1:8788/api/auth/google/callback   (development)

# --- mail, for the forgot-password link ---------------------------------
# Either Resend (recommended) or any HTTP mail endpoint that takes
# { to, subject, html }:
RESEND_API_KEY=
# MAIL_API_URL=      # e.g. a MailChannels/Postmark wrapper
# MAIL_API_KEY=
# MAILER_API_KEY=
MAIL_FROM="Fly Dragon AI <no-reply@flytripvisa.site>"

# --- real data sources (all optional; missing = tool reports needs_setup) --
IATA_API_KEY=              # live Timatic visa rules
AMADEUS_CLIENT_ID=         # flights + hotels (Amadeus)
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE=https://test.api.amadeus.com
SERPAPI_KEY=               # Google Flights / Google Hotels fallback
PARALLEL_API_KEY=          # live web search
EXCHANGE_API_KEY=          # fx rates (frankfurter.app is used without a key)
MCP_WEB_SEARCH_URL=        # hosted web-search MCP endpoint
MCP_WEB_SEARCH_KEY=

# --- plain vars (mirrored in wrangler.toml [vars]) -----------------------
PUBLIC_ORIGIN=https://flytripvisa.site
ADDITIONAL_ORIGINS=http://127.0.0.1:8788,http://localhost:5173
R2_BUCKET_NAME=fly-dragon-uploads
STORAGE_LIMIT_BYTES=1073741824
CHAT_RATE_LIMIT=20
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=6
FORGOT_RATE_LIMIT=4
IMAGE_RATE_LIMIT=8
UPLOAD_RATE_LIMIT=30
TOOL_TIMEOUT_MS=12000
STREAM_TIMEOUT_MS=120000
HISTORY_LIMIT=200
